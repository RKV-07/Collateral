# GOOGLE_API_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Fallback LLM provider when Gemini is unavailable.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# POOLSIDE_API_KEY: Second fallback LLM provider (Poolside Laguna).
# Get a key at https://platform.poolside.ai/
POOLSIDE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
