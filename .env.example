# ZYLOO_API_KEY: Primary LLM provider (free Gemini/GPT models via zyloo proxy).
# Get a key at https://zyloo.io/
ZYLOO_API_KEY=""

# OPENROUTER_API_KEY: Fallback LLM provider when Zyloo is unavailable.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# POOLSIDE_API_KEY: Second fallback LLM provider (Poolside Laguna).
# Get a key at https://platform.poolside.ai/
POOLSIDE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
