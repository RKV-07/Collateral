# GROQ_API_KEY: Primary LLM provider (fast inference, free tier ~14,400 req/day).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Fallback LLM provider when Groq is unavailable.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# POOLSIDE_API_KEY: Second fallback LLM provider (Poolside Laguna).
# Get a key at https://platform.poolside.ai/
POOLSIDE_API_KEY=""

# SLACK_WEBHOOK_URL: (Optional) Slack incoming webhook for High Risk margin call alerts.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
