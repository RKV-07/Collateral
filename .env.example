# GEMINI_API_KEY: Primary LLM provider (Google Gemini — required for XPRIZE eligibility).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# GEMINI_MODEL: Which Gemini model to use by default. Override if you prefer another.
GEMINI_MODEL="gemini-3-flash-preview"

# GROQ_API_KEY: Primary LLM provider (fast inference, free tier ~14,400 req/day).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Fallback LLM provider when Groq is unavailable.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# POOLSIDE_API_KEY: Second fallback LLM provider (Poolside Laguna).
# Get a key at https://platform.poolside.ai/
POOLSIDE_API_KEY=""

# SLACK_WEBHOOK_URL: (Optional) Slack incoming webhook for High Risk margin call alerts.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin panel access (email + password login, coexists with Google OAuth).
# Generate ADMIN_PASSWORD_HASH with: bun run hash:admin <password>
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""

# SESSION_SECRET: signs the session cookie. REQUIRED in production — the
# server refuses to boot without it (no insecure fallback outside dev).
SESSION_SECRET=""
